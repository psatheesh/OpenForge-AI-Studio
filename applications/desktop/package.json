{
  "private": true,
  "name": "@openforge/desktop",
  "productName": "OpenForge AI Studio",
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "OpenForge AI Studio",
        "reloadOnReconnect": true,
        "preferences": {
          "toolbar.showToolbar": true
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "configurationFolder": ".openforge"
      }
    }
  },
  "dependencies": {
    "@openforge/product": "0.2.0",
    "@theia/ai-anthropic": "1.75.0",
