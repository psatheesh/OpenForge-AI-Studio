  "devDependencies": {
    "@theia/cli": "1.75.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "build": "npm run rebuild && theia build --mode development",
    "build:production": "npm run rebuild && theia build --mode production",
    "rebuild": "theia rebuild:electron --cacheRoot ../..",
    "start": "theia start ",
    "clean": "theia clean"
  },
  "main": "lib/backend/electron-main.js"
}
